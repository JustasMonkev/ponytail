{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node -e \"var r=process.env.PLUGIN_ROOT;r=require('fs').existsSync(r)?r:r.split(String.fromCharCode(92)).join('/');require(r+'/hooks/ponytail-activate.js')\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\ponytail-activate.js\"",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node -e \"var r=process.env.PLUGIN_ROOT;r=require('fs').existsSync(r)?r:r.split(String.fromCharCode(92)).join('/');require(r+'/hooks/ponytail-mode-tracker.js')\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\ponytail-mode-tracker.js\"",
        "timeoutSec": 5
      }
    ]
  }
}
