{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node -e \"require(process.env.PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/') + '/hooks/ponytail-activate.js')\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\ponytail-activate.js\"",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node -e \"require(process.env.PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/') + '/hooks/ponytail-mode-tracker.js')\"",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\ponytail-mode-tracker.js\"",
        "timeoutSec": 5
      }
    ]
  }
}
